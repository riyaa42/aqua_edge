[RULES]
RULE B-ON
 IF Tank B-TANK level < 0.5
 THEN Pump B-PUMP status = OPEN
 PRIORITY 1
 ; end of rule

RULE B-OFF
 IF Tank B-TANK level > 1.9
 THEN Pump B-PUMP status = CLOSED
 PRIORITY 1
 ; end of rule

RULE POWER-CUT
 IF SYSTEM TIME >= 33:00:00
  AND SYSTEM TIME Below 41:00:00
 THEN Pump B-PUMP status = CLOSED
 PRIORITY 5
 ; end of rule


