# A virtual edge node (edge-based solution): replays the sensor dataset, talks to the gateway over
# the network, and only logs what its LEDs and valve would do. Used by the one-node and three-nodes
# profiles of compose.yaml. A real Raspberry Pi runs the node directly, not from this image.
# Libraries come from uv.lock; .dockerignore keeps data, keys and .env out.
FROM docker.io/library/python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11.16 /uv /bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock .python-version ./
RUN UV_PYTHON_DOWNLOADS=never uv sync --locked --no-cache --no-install-project --no-default-groups
# only the node's code, the building tree it needs and the one dataset it replays
COPY detection detection
COPY edge edge
COPY hal hal
COPY gateway/__init__.py gateway/topology.py gateway/building_B.json gateway/
COPY simulation/webots/data/sensors.csv simulation/webots/data/
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
