# Copy to .env (never committed) and fill in.
MQTT_GATEWAY_PASSWORD=
MQTT_VIEWER_PASSWORD=
# A long random secret the gateway uses to send to the dashboard
AQUA_DASHBOARD_TOKEN=
# Full path of the gateway's key file (hal/README.md, "Encryption")
GATEWAY_KEYS=
# The building tree, if not building B (gateway/README.md, "Building tree")
# GATEWAY_TREE=./gateway/building_B.json
# GATEWAY_SERIAL=/dev/ttyUSB0
# MQTT_PORT=1883
# DASHBOARD_PORT=8000
# AQUA_ENABLE_OUTAGE_SIM=1
# DASHBOARD_GATEWAY_ID=building-B
# To send to a dashboard elsewhere instead of this setup's own
# DASHBOARD_URL=
