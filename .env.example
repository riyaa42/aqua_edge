# Copy to .env (never committed) and fill in.
MQTT_GATEWAY_PASSWORD=
MQTT_VIEWER_PASSWORD=
# A long random secret the gateway uses to send to the dashboard
AQUA_DASHBOARD_TOKEN=
# For the dashboard's valve reopen button: another long random secret. Unset: reopening is off
# AQUA_OPERATOR_TOKEN=
# Full path of the gateway's key file (hal/README.md, "Encryption")
GATEWAY_KEYS=
# The building tree, if not building B (gateway/README.md, "Building tree")
# GATEWAY_TREE=./gateway/building_B.json
# With compose.esp8266.yaml: the modem's serial port on this computer
# GATEWAY_SERIAL=/dev/ttyUSB0
# The 4 virtual edge nodes (--profile virtual-nodes): each node's own key file, full path.
# Also set GATEWAY_TREE=./gateway/virtual_4node.json above
# NODE_TANK_KEYS=
# NODE_B101_KEYS=
# NODE_B203_KEYS=
# NODE_B301_KEYS=
# NODE_PRIME_S=86400
# NODE_STEP_S=
# NODE_REOPEN_AFTER_S=1800        # valves reopening: set on the (cloud-based) gateway, for every node
# NODE_TRIAL_REOPEN=0
# MQTT_PORT=1883
# DASHBOARD_PORT=8000
# AQUA_ENABLE_OUTAGE_SIM=1
# DASHBOARD_GATEWAY_ID=building-B
# To send to a dashboard elsewhere instead of this setup's own
# DASHBOARD_URL=
